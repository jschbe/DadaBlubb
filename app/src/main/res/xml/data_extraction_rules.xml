<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: exclude every Android app-data domain from cloud backup;
     allow supported device-to-device transfers explicitly. Cache/no-backup
     directories remain excluded by Android in both rule formats. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
        <include domain="device_root" path="." />
        <include domain="device_file" path="." />
        <include domain="device_database" path="." />
        <include domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
