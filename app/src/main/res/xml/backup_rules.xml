<?xml version="1.0" encoding="utf-8"?>
<!-- API 28–30: only transports declaring device-to-device transfer may include data.
     allowBackup stays true so supported local transfers remain possible.
     Explicit includes disable default inclusion of all other data. -->
<full-backup-content>
    <include domain="root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="external" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
